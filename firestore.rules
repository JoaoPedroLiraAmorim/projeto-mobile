rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Contatos (agenda pessoal segura criptografada - funcionalidade original mantida)
    match /contacts/{id} {
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // 2. Usuários do sistema
    match /usuarios/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // 3. Notebooks (patrimônio, especificações e status)
    match /notebooks/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // 4. Reservas de Notebooks (verificação de conflito e agendamento)
    match /reservas/{id} {
      // Leitura permitida para autenticados para que seja possível validar sobreposição/conflito de horários
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // 5. Rastreamento de Uso de Notebooks (retiradas e devoluções em tempo real)
    match /uso_notebooks/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}